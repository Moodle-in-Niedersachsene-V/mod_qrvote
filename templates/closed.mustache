{{!
    @template mod_qrvote/closed

    Vote page of a round that no longer accepts votes.

    Context variables required for this template:
    * question - Question, already formatted with format_text().
    * showresults - Whether the result is shown.
    * results - Result context for mod_qrvote/results.

    Example context (json):
    {
        "question": "Which topic should we revise first?",
        "showresults": false,
        "results": {"roundid": 3, "open": false, "voters": 0, "options": []}
    }
}}
<div class="mod_qrvote-closed">
    <div class="alert alert-warning" role="status">{{#str}}error:roundclosed, mod_qrvote{{/str}}</div>
    <div class="mod_qrvote-question h5 mb-3">{{{question}}}</div>
    {{#showresults}}
    {{#results}}{{>mod_qrvote/results}}{{/results}}
    {{/showresults}}
</div>
