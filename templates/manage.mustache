{{!
    @template mod_qrvote/manage

    Teacher page with QR code, live result, round controls, stations and round history.

    Context variables required for this template:
    * cmid - Course module id.
    * question - Question, already formatted with format_text().
    * canmanage - Whether the user may start, stop and delete rounds and edit stations.
    * actionurl - URL of view.php for the control forms.
    * sesskey - Session key.
    * ispublic - Whether voting works without login.
    * multiple - Whether several options may be chosen.
    * addstationurl - URL to create a station.
    * hasstations - Whether stations exist.
    * printallurl - URL of the PDF with one page per station.
    * hasround - Whether a round is selected.
    * round - Selected round: id, started, isstation, title, location, window, open, scheduled, url, editurl,
      printurl, voteurl, showqr, qrcode (data URI), results, hasmoderation, moderation (text, normalized,
      count, hidden).
    * hasrounds - Whether rounds exist.
    * rounds - Rounds: id, started, isstation, title, location, window, open, scheduled, url, editurl, printurl,
      voters, selected.
    * qrhelp - Help icon context.

    Example context (json):
    {
        "cmid": 12,
        "question": "How did you like the talk?",
        "canmanage": true,
        "actionurl": "https://example.org/mod/qrvote/view.php?id=12",
        "sesskey": "abc123",
        "ispublic": true,
        "multiple": false,
        "addstationurl": "https://example.org/mod/qrvote/schedule.php?id=12",
        "hasstations": true,
        "printallurl": "https://example.org/mod/qrvote/print.php?id=12",
        "hasround": true,
        "round": {
            "id": 3, "started": "Saturday, 24 October 2026, 10:00 AM", "isstation": true,
            "title": "Moodle and AI", "location": "Room 104", "window": "Saturday, 24 October, 10:00 AM to 11:30 AM",
            "open": false, "scheduled": true,
            "url": "https://example.org/mod/qrvote/view.php?id=12&roundid=3",
            "editurl": "https://example.org/mod/qrvote/schedule.php?id=12&roundid=3",
            "printurl": "https://example.org/mod/qrvote/print.php?id=12&roundid=3",
            "voteurl": "https://example.org/mod/qrvote/vote.php?t=0123456789abcdef0123456789abcdef",
            "showqr": true,
            "hasmoderation": false,
            "moderation": [],
            "qrcode": "data:image/svg+xml;base64,PHN2Zy8+",
            "results": {"roundid": 3, "open": false, "scheduled": true, "voters": 0, "options": [
                {"id": 1, "text": "Very good", "votes": 0, "percent": 0}
            ]}
        },
        "hasrounds": true,
        "rounds": [
            {"id": 3, "started": "Saturday, 24 October 2026, 10:00 AM", "isstation": true, "title": "Moodle and AI",
             "location": "Room 104", "window": "Saturday, 24 October, 10:00 AM to 11:30 AM", "open": false,
             "scheduled": true, "voters": 0, "selected": true,
             "url": "https://example.org/mod/qrvote/view.php?id=12&roundid=3",
             "editurl": "https://example.org/mod/qrvote/schedule.php?id=12&roundid=3",
             "printurl": "https://example.org/mod/qrvote/print.php?id=12&roundid=3"}
        ],
        "qrhelp": {"title": "Help with QR code", "alt": "Help", "url": "#", "ltr": true, "text": "Scan the code."}
    }
}}
<div class="mod_qrvote-manage" data-region="mod_qrvote-manage">
    <div class="mod_qrvote-question h4 mb-3">{{{question}}}</div>
    <p class="text-muted small">
        {{#ispublic}}{{#str}}modepublic, mod_qrvote{{/str}}{{/ispublic}}
        {{^ispublic}}{{#str}}modelogin, mod_qrvote{{/str}}{{/ispublic}}
        {{#multiple}} · {{#str}}modemultiple, mod_qrvote{{/str}}{{/multiple}}
    </p>

    {{#canmanage}}
    <div class="d-flex flex-wrap gap-2 mb-4">
        <form method="post" action="{{actionurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="start">
            <button type="submit" class="btn btn-primary">{{#str}}startround, mod_qrvote{{/str}}</button>
        </form>
        <a class="btn btn-secondary" href="{{addstationurl}}">{{#str}}addstation, mod_qrvote{{/str}}</a>
        {{#hasstations}}
        <a class="btn btn-outline-secondary" href="{{printallurl}}">{{#str}}printall, mod_qrvote{{/str}}</a>
        {{/hasstations}}
    </div>
    {{/canmanage}}

    {{#hasround}}
    <div class="mod_qrvote-stage card mb-4" data-region="mod_qrvote-stage">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                    {{#round.isstation}}
                    <h3 class="h5 mb-1">{{round.title}}</h3>
                    <p class="mb-0 text-muted">{{#round.location}}{{round.location}} · {{/round.location}}{{round.window}}</p>
                    {{/round.isstation}}
                    {{^round.isstation}}
                    <h3 class="h5 mb-0">{{#str}}roundstarted, mod_qrvote, {{round.started}}{{/str}}</h3>
                    {{/round.isstation}}
                </div>
                <div class="d-flex flex-wrap gap-2">
                    {{#canmanage}}{{#round.open}}
                    <form method="post" action="{{actionurl}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="stop">
                        <input type="hidden" name="roundid" value="{{round.id}}">
                        <button type="submit" class="btn btn-secondary btn-sm">{{#str}}stopround, mod_qrvote{{/str}}</button>
                    </form>
                    {{/round.open}}{{/canmanage}}
                    {{#round.isstation}}
                    <a class="btn btn-outline-secondary btn-sm" href="{{round.printurl}}">{{#str}}printstation, mod_qrvote{{/str}}</a>
                    {{/round.isstation}}
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-action="mod_qrvote-fullscreen">
                        {{#str}}fullscreen, mod_qrvote{{/str}}
                    </button>
                </div>
            </div>
            <div class="row">
                {{#round.showqr}}
                <div class="col-md-5 text-center mb-3">
                    <h4 class="h6">{{#str}}scantovote, mod_qrvote{{/str}} {{#qrhelp}}{{>core/help_icon}}{{/qrhelp}}</h4>
                    <img class="mod_qrvote-qrcode img-fluid" src="{{round.qrcode}}" alt="{{#str}}qrcodealt, mod_qrvote{{/str}}">
                    <p class="mod_qrvote-url small text-break mt-2">
                        <a href="{{round.voteurl}}" target="_blank" rel="noopener">{{round.voteurl}}</a>
                    </p>
                </div>
                {{/round.showqr}}
                <div class="{{#round.showqr}}col-md-7{{/round.showqr}}{{^round.showqr}}col-12{{/round.showqr}}"
                    data-region="mod_qrvote-results" data-roundid="{{round.id}}">
                    {{#round.results}}{{>mod_qrvote/results}}{{/round.results}}
                </div>
            </div>
            {{#round.hasmoderation}}
            <details class="mod_qrvote-moderation mt-3">
                <summary>{{#str}}moderatewords, mod_qrvote{{/str}}</summary>
                <ul class="list-unstyled mt-2 mb-0">
                    {{#round.moderation}}
                    <li class="d-flex justify-content-between align-items-center border-bottom py-1">
                        <span{{#hidden}} class="text-muted text-decoration-line-through"{{/hidden}}>{{text}} ({{count}})</span>
                        <form method="post" action="{{actionurl}}" class="d-inline">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="roundid" value="{{round.id}}">
                            <input type="hidden" name="word" value="{{normalized}}">
                            {{#hidden}}
                            <input type="hidden" name="action" value="showword">
                            <button type="submit" class="btn btn-link btn-sm p-0">{{#str}}showword, mod_qrvote{{/str}}</button>
                            {{/hidden}}
                            {{^hidden}}
                            <input type="hidden" name="action" value="hideword">
                            <button type="submit" class="btn btn-link btn-sm text-danger p-0">{{#str}}hideword, mod_qrvote{{/str}}</button>
                            {{/hidden}}
                        </form>
                    </li>
                    {{/round.moderation}}
                </ul>
            </details>
            {{/round.hasmoderation}}
        </div>
    </div>
    {{/hasround}}
    {{^hasround}}
    <div class="alert alert-info">{{#str}}noroundsyet, mod_qrvote{{/str}}</div>
    {{/hasround}}

    {{#hasrounds}}
    <h3 class="h5">{{#str}}roundhistory, mod_qrvote{{/str}}</h3>
    <div class="table-responsive">
    <table class="table table-sm generaltable mod_qrvote-rounds">
        <thead>
            <tr>
                <th scope="col">{{#str}}round, mod_qrvote{{/str}}</th>
                <th scope="col">{{#str}}status, mod_qrvote{{/str}}</th>
                <th scope="col">{{#str}}voters, mod_qrvote{{/str}}</th>
                <th scope="col"><span class="visually-hidden">{{#str}}actions{{/str}}</span></th>
            </tr>
        </thead>
        <tbody>
            {{#rounds}}
            <tr{{#selected}} class="table-active"{{/selected}}>
                <td>
                    {{#isstation}}
                    <a href="{{url}}">{{title}}</a>
                    <div class="small text-muted">{{#location}}{{location}} · {{/location}}{{window}}</div>
                    {{/isstation}}
                    {{^isstation}}<a href="{{url}}">{{started}}</a>{{/isstation}}
                </td>
                <td>
                    {{#open}}{{#str}}roundopen, mod_qrvote{{/str}}{{/open}}
                    {{#scheduled}}{{#str}}roundscheduled, mod_qrvote{{/str}}{{/scheduled}}
                    {{^open}}{{^scheduled}}{{#str}}roundclosed, mod_qrvote{{/str}}{{/scheduled}}{{/open}}
                </td>
                <td>{{voters}}</td>
                <td class="text-end text-nowrap">
                    {{#isstation}}
                    <a class="btn btn-link btn-sm p-0 me-2" href="{{printurl}}">{{#str}}print, mod_qrvote{{/str}}</a>
                    {{/isstation}}
                    {{#canmanage}}
                    {{#isstation}}
                    <a class="btn btn-link btn-sm p-0 me-2" href="{{editurl}}">{{#str}}edit{{/str}}</a>
                    {{/isstation}}
                    <form method="post" action="{{actionurl}}" class="d-inline">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="delete">
                        <input type="hidden" name="roundid" value="{{id}}">
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0">{{#str}}delete{{/str}}</button>
                    </form>
                    {{/canmanage}}
                </td>
            </tr>
            {{/rounds}}
        </tbody>
    </table>
    </div>
    {{/hasrounds}}
</div>
