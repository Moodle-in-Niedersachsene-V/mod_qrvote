{{!
    @template mod_qrvote/student

    Activity page for participants without access to the results.

    Context variables required for this template:
    * question - Question, already formatted with format_text().
    * open - Whether a round accepts votes.
    * canvote - Whether the user may vote in the open round.
    * voteurl - URL of the vote page of the open round.

    Example context (json):
    {
        "question": "Which topic should we revise first?",
        "open": true,
        "canvote": true,
        "voteurl": "https://example.org/mod/qrvote/vote.php?t=0123456789abcdef0123456789abcdef"
    }
}}
<div class="mod_qrvote-student">
    <div class="mod_qrvote-question h4 mb-3">{{{question}}}</div>
    {{#open}}
        {{#canvote}}
        <a class="btn btn-primary btn-lg" href="{{voteurl}}">{{#str}}votenow, mod_qrvote{{/str}}</a>
        {{/canvote}}
        {{^canvote}}
        <div class="alert alert-info">{{#str}}cannotvote, mod_qrvote{{/str}}</div>
        {{/canvote}}
    {{/open}}
    {{^open}}
    <div class="alert alert-info">{{#str}}noopenround, mod_qrvote{{/str}}</div>
    {{/open}}
</div>
