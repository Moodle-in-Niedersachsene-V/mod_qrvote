{{!
    @template mod_qrvote/results

    Result of one voting round as horizontal bars. Also rendered by the live view in JavaScript.

    Context variables required for this template:
    * roundid - Round id.
    * open - Whether the round accepts votes.
    * scheduled - Whether the window of a scheduled round has not started yet.
    * voters - Number of voters.
    * israting - Whether voters give 1 to 5 stars.
    * hasaverage - Whether an average rating exists.
    * average - Average rating, formatted.
    * averagestars - Average rating as star glyphs.
    * options - List of options with id, text (plain text), votes, percent and stars (glyphs, rating only).

    Example context (json):
    {
        "roundid": 3,
        "open": true,
        "scheduled": false,
        "voters": 24,
        "israting": false,
        "hasaverage": false,
        "average": "",
        "averagestars": "",
        "options": [
            {"id": 1, "text": "Yes", "votes": 15, "percent": 63, "stars": ""},
            {"id": 2, "text": "No", "votes": 9, "percent": 38, "stars": ""}
        ]
    }
}}
<div class="mod_qrvote-results" data-region="results" aria-live="polite">
    <p class="mod_qrvote-voters mb-3">
        <span class="badge {{#open}}bg-success{{/open}}{{#scheduled}}bg-info{{/scheduled}}{{^open}}{{^scheduled}}bg-secondary{{/scheduled}}{{/open}} me-2">
            {{#open}}{{#str}}roundopen, mod_qrvote{{/str}}{{/open}}
            {{#scheduled}}{{#str}}roundscheduled, mod_qrvote{{/str}}{{/scheduled}}
            {{^open}}{{^scheduled}}{{#str}}roundclosed, mod_qrvote{{/str}}{{/scheduled}}{{/open}}
        </span>
        {{#str}}votersnum, mod_qrvote, {{voters}}{{/str}}
    </p>
    {{#hasaverage}}
    <p class="mod_qrvote-average h4 mb-3">
        <span class="mod_qrvote-stars" aria-hidden="true">{{averagestars}}</span>
        {{#str}}ratingaverage, mod_qrvote, {{average}}{{/str}}
    </p>
    {{/hasaverage}}
    <ul class="list-unstyled mb-0">
        {{#options}}
        <li class="mb-3">
            <div class="d-flex justify-content-between">
                {{#stars}}
                <span class="fw-bold"><span class="mod_qrvote-stars" aria-hidden="true">{{stars}}</span><span class="visually-hidden">{{text}}</span></span>
                {{/stars}}
                {{^stars}}<span class="fw-bold">{{text}}</span>{{/stars}}
                <span>{{#str}}votesnum, mod_qrvote, { "votes": {{votes}}, "percent": {{percent}} }{{/str}}</span>
            </div>
            <div class="progress mod_qrvote-bar" role="progressbar" aria-label="{{text}}"
                aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: {{percent}}%"></div>
            </div>
        </li>
        {{/options}}
    </ul>
</div>
